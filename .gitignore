.DS_Store
__pycache__/
*.pyc

# Nextflow runtime artifacts
.nextflow/
.nextflow.log*
work/
demos/nextflow-qc/results/
/demos/ngs-workbench-qc/runs/
/demos/ngs-workbench-qc/data/*
!/demos/ngs-workbench-qc/data/.gitkeep

# AI-agent generated classroom outputs
demos/ai-agent/outputs/

# Local rendering / QA intermediates; keep final PDFs, slides and teaching outputs.
/tmp/
/output/playwright/

# Local environments and credentials must not enter the public repository.
.venv/
node_modules/
.env
.env.*
!.env.example
*.pem
*.key

# Learner-generated lesson 01/02 practice runs (keep supplied practice01 fixtures).
/demos/lesson-01-genomics/practice-local*/
/demos/lesson-02-somatic/practice-local*/
