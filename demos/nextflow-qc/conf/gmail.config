// Optional SMTP configuration. Never include account passwords in this file.
// Load explicitly with -c conf/gmail.config, and enable sending with -N ADDRESS.
mail {
    from = secrets.GMAIL_SMTP_USER
    debug = false
    smtp {
        host = 'smtp.gmail.com'
        port = 587
        user = secrets.GMAIL_SMTP_USER
        password = secrets.GMAIL_APP_PASSWORD
        auth = true
        starttls.enable = true
        starttls.required = true
        ssl.enable = false
        connectiontimeout = 10000
        timeout = 30000
        writetimeout = 30000
    }
}

notification {
    enabled = false
    from = secrets.GMAIL_SMTP_USER
    template = "${projectDir}/conf/workflow-status.txt"
}
